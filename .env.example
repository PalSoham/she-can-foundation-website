# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
PORT=5000

# TiDB Database Configuration (MySQL Compatible)
# If DB_HOST is left empty or connection fails, the application will fallback to a local SQLite database (submissions.db)
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL_CA=
